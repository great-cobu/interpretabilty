    {
      "id": "MJUe",
      "code_hash": "98fec6bee452804d2e79564c2f769d13",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<div class=\"mnist-prose mnist-supporting\"><span class=\"markdown prose dark:prose-invert contents\"><h1 id=\"riemannian-activation-manifold-steering-interactive-demo\">Riemannian Activation Manifold Steering \u2014 Interactive Demo</h1>\n<span class=\"paragraph\">When steering a neural network representation from a starting concept <marimo-tex class=\"arithmatex\">||(x_A||)</marimo-tex> toward a target concept <marimo-tex class=\"arithmatex\">||(x_B||)</marimo-tex>, <strong>Euclidean linear steering</strong> (<marimo-tex class=\"arithmatex\">||(u_{\\text{lin}}(t) = (1 - t)u_A + t u_B||)</marimo-tex>) moves in a straight line in flat coordinates, cutting blindly through regions of high curvature and rapid representation distortion.</span>\n<span class=\"paragraph\">Equipping the local chart <marimo-tex class=\"arithmatex\">||(u = (u^1, u^2) \\in \\mathbb{R}^2||)</marimo-tex> with the <strong>pullback Riemannian metric</strong> <marimo-tex class=\"arithmatex\">||(g_{ij}(u) = (J_h(u)^\\top J_h(u))_{ij}||)</marimo-tex> (or the <strong>Fisher Information Metric</strong> <marimo-tex class=\"arithmatex\">||(g^F_{ij}(u)||)</marimo-tex>) and <strong>Christoffel symbols</strong> <marimo-tex class=\"arithmatex\">||(\\Gamma^k_{ij}(u)||)</marimo-tex> via <code>torch.func.jacrev</code> allows us to compute <strong>Riemannian geodesic steering trajectories</strong> that minimize path energy:</span>\n<marimo-tex class=\"arithmatex\">||[E[\\gamma] = \\frac{1}{2}\\int_0^1 g_{ij}(\\gamma(t))\\,\\dot{\\gamma}^i(t)\\,\\dot{\\gamma}^j(t)\\,dt \\qquad \\Longleftrightarrow \\qquad \\ddot{\\gamma}^k(t) + \\Gamma^k_{ij}(\\gamma(t))\\,\\dot{\\gamma}^i(t)\\,\\dot{\\gamma}^j(t) = 0||]</marimo-tex></span></div>"
          }
        }
      ],
      "console": []
    },
    {
      "id": "vblA",
      "code_hash": "5e2e30d19648cb050a576bd0fc1dba8b",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><div class=\"mnist-prose mnist-supporting\"><span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"1-select-or-train-a-smooth-cnn-smu-softplus\">1. Select or Train a Smooth CNN (<code>SMU</code> / <code>Softplus</code>)</h2>\n<span class=\"paragraph\">Second-order automatic differentiation (<code>christoffel_symbols</code>) requires a <marimo-tex class=\"arithmatex\">||(C^2||)</marimo-tex>-smooth activation function such as <strong><code>SMU</code></strong> or <strong><code>Softplus</code></strong>. Train a new checkpoint below or pick an existing run.</span></span></div><marimo-ui-element object-id='vblA-11' random-id='8ca39d23-f9ed-693b-755b-46651b7fcd41'><marimo-form data-initial-value='null' data-label='null' data-element-id='&quot;vblA-10&quot;' data-loading='false' data-bordered='true' data-submit-button-label='&quot;Train smooth CNN checkpoint&quot;' data-submit-button-disabled='false' data-clear-on-submit='false' data-show-clear-button='false' data-clear-button-label='&quot;Clear&quot;' data-should-validate='false'><marimo-ui-element object-id='vblA-10' random-id='dbe2be3f-3322-9233-930d-67692f3673a2'><marimo-dict data-initial-value='{&quot;activation&quot;:[&quot;SMU (Smooth Maximum Unit \u2014 C^\u221e smooth)&quot;],&quot;epochs&quot;:2,&quot;threads&quot;:8}' data-label='null' data-element-ids='{&quot;vblA-7&quot;:&quot;activation&quot;,&quot;vblA-8&quot;:&quot;epochs&quot;,&quot;vblA-9&quot;:&quot;threads&quot;}'><marimo-json-output data-json-data='{&quot;activation&quot;:&quot;text/html:&#92;u003cmarimo-ui-element object-id=&#x27;vblA-7&#x27; random-id=&#x27;1cc1e997-f2a4-e6fc-f9c4-22b69b71c543&#x27;&#92;u003e&#92;u003cmarimo-dropdown data-initial-value=&#x27;[&amp;quot;SMU (Smooth Maximum Unit \u2014 C^\u221e smooth)&amp;quot;]&#x27; data-label=&#x27;&amp;quot;&amp;#92;u003cspan class=&amp;#92;&amp;quot;markdown prose dark:prose-invert contents&amp;#92;&amp;quot;&amp;#92;u003e&amp;#92;u003cspan class=&amp;#92;&amp;quot;paragraph&amp;#92;&amp;quot;&amp;#92;u003eCNN Activation Function&amp;#92;u003c/span&amp;#92;u003e&amp;#92;u003c/span&amp;#92;u003e&amp;quot;&#x27; data-options=&#x27;[&amp;quot;SMU (Smooth Maximum Unit \u2014 C^\u221e smooth)&amp;quot;,&amp;quot;Softplus (C^\u221e smooth)&amp;quot;,&amp;quot;ReLU (piecewise linear \u2014 zero 2nd derivative)&amp;quot;]&#x27; data-allow-select-none=&#x27;false&#x27; data-searchable=&#x27;false&#x27; data-full-width=&#x27;false&#x27; data-disabled=&#x27;false&#x27;&#92;u003e&#92;u003c/marimo-dropdown&#92;u003e&#92;u003c/marimo-ui-element&#92;u003e&quot;,&quot;epochs&quot;:&quot;text/html:&#92;u003cmarimo-ui-element object-id=&#x27;vblA-8&#x27; random-id=&#x27;00e2c728-e97b-2345-5ada-123fe9d5ebfe&#x27;&#92;u003e&#92;u003cmarimo-number data-initial-value=&#x27;2&#x27; data-label=&#x27;&amp;quot;&amp;#92;u003cspan class=&amp;#92;&amp;quot;markdown prose dark:prose-invert contents&amp;#92;&amp;quot;&amp;#92;u003e&amp;#92;u003cspan class=&amp;#92;&amp;quot;paragraph&amp;#92;&amp;quot;&amp;#92;u003eTraining epochs&amp;#92;u003c/span&amp;#92;u003e&amp;#92;u003c/span&amp;#92;u003e&amp;quot;&#x27; data-start=&#x27;1&#x27; data-stop=&#x27;20&#x27; data-step=&#x27;1&#x27; data-debounce=&#x27;false&#x27; data-full-width=&#x27;false&#x27; data-disabled=&#x27;false&#x27;&#92;u003e&#92;u003c/marimo-number&#92;u003e&#92;u003c/marimo-ui-element&#92;u003e&quot;,&quot;threads&quot;:&quot;text/html:&#92;u003cmarimo-ui-element object-id=&#x27;vblA-9&#x27; random-id=&#x27;c66e0fcc-179d-de9e-1db7-532c246473c0&#x27;&#92;u003e&#92;u003cmarimo-number data-initial-value=&#x27;8&#x27; data-label=&#x27;&amp;quot;&amp;#92;u003cspan class=&amp;#92;&amp;quot;markdown prose dark:prose-invert contents&amp;#92;&amp;quot;&amp;#92;u003e&amp;#92;u003cspan class=&amp;#92;&amp;quot;paragraph&amp;#92;&amp;quot;&amp;#92;u003eCPU threads&amp;#92;u003c/span&amp;#92;u003e&amp;#92;u003c/span&amp;#92;u003e&amp;quot;&#x27; data-start=&#x27;1&#x27; data-stop=&#x27;16&#x27; data-step=&#x27;1&#x27; data-debounce=&#x27;false&#x27; data-full-width=&#x27;false&#x27; data-disabled=&#x27;false&#x27;&#92;u003e&#92;u003c/marimo-number&#92;u003e&#92;u003c/marimo-ui-element&#92;u003e&quot;}' data-value-types='&quot;python&quot;' data-name='&quot;dictionary&quot;'></marimo-json-output></marimo-dict></marimo-ui-element></marimo-form></marimo-ui-element></div>"
          }
